# ==============================================================================
# FinSecure RAG: Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# LLM Inference Credentials
GROQ_API_KEY=your_groq_api_key_here

# LangSmith Observability Credentials (Optional but recommended)
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=finsecure-rag-eval-suite

# Cloudflare Workers & AI Gateway Deployment Credentials
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
AI_GATEWAY_ID=finsecure-gateway
